// Praetoria Servicios data model.
// Full business model — issue #9 ("Modelar solicitudes, estados y trazabilidad").
// Rules: server-validated transitions, immutable status history, non-sequential
// public identifiers, PII separated from technical logs, consistent timezone (UTC).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Requests (Solicitudes)
// ─────────────────────────────────────────────────────────────────────────────

enum RequestStatus {
  BORRADOR
  PENDIENTE_ANALISIS
  REQUIERE_INFORMACION
  VALIDADA_CLIENTE
  EN_REVISION
  PRESUPUESTO_PREPARADO
  PRESUPUESTO_ENVIADO
  ACEPTADA
  RECHAZADA
  CANCELADA
  CERRADA
}

enum Urgency {
  BAJA
  MEDIA
  ALTA
  EMERGENCIA
}

enum ContactChannel {
  WHATSAPP
  EMAIL
}

model Request {
  id            String        @id @default(cuid())
  // Public, non-sequential reference shown to the client (e.g. PS-7Q2M-KX9A).
  reference     String        @unique
  status        RequestStatus @default(BORRADOR)
  trade         String? // resolved trade key (see src/config/trades.ts); null while "no sé"
  clientChoseUnsure Boolean   @default(false)
  urgency       Urgency?
  problemText   String? // client's own words (PII-adjacent — never logged)

  municipality  String?
  postalCode    String?
  withinCoverage Boolean?

  // SEO attribution (issue #27) — first-touch landing PATH only (no query
  // string) + referrer HOST only. Never PII, never a full URL.
  entryPath         String?
  entryReferrerHost String?

  contact       Contact?
  location      RequestLocation?
  photos        Photo[]
  analyses      AnalysisVersion[]
  corrections   ClientCorrection[]
  quotes        Quote[]
  communications Communication[]
  consents      Consent[]
  statusHistory StatusEvent[]
  insurance     InsuranceCase?
  assignments   Assignment[]
  completion    ServiceCompletion?
  incidences    Incidence[]
  review        Review?

  // Draft lifecycle / retention (issue #9, #17)
  submittedAt   DateTime?
  expiresAt     DateTime? // for BORRADOR expiry
  closedAt      DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([trade])
  @@index([municipality])
  @@index([createdAt])
  @@index([submittedAt])
}

// Contact data kept in its own table to separate PII from the rest.
model Contact {
  id             String         @id @default(cuid())
  request        Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId      String         @unique
  name           String
  phone          String?
  email          String?
  preferredChannel ContactChannel
  availabilityNote String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model RequestLocation {
  id           String   @id @default(cuid())
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId    String   @unique
  municipality String
  postalCode   String
  approxNote   String?
  createdAt    DateTime @default(now())
}

model Photo {
  id           String   @id @default(cuid())
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId    String
  // Storage key in the private blob store — not a public URL.
  storageKey   String
  contentType  String
  byteSize     Int
  width        Int?
  height       Int?
  position     Int      @default(0)
  hint         String? // "vista general" | "detalle" | "etiqueta" | "zona"
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([requestId, position])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI analysis (issues #7, #8)
// ─────────────────────────────────────────────────────────────────────────────

enum AnalysisOutcome {
  OK
  NEEDS_MORE_INFO
  PROVIDER_ERROR
}

model AnalysisVersion {
  id             String          @id @default(cuid())
  request        Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId      String
  version        Int
  isActive       Boolean         @default(false)
  outcome        AnalysisOutcome
  promptVersion  String
  // Structured, schema-validated result (src/domain/analysis). No provider "reasoning".
  result         Json
  confidence     Int? // 0..100
  requiresOnSiteInspection Boolean @default(false)
  createdAt      DateTime        @default(now())

  @@unique([requestId, version])
  @@index([requestId, isActive])
}

model ClientCorrection {
  id           String   @id @default(cuid())
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId    String
  // Which parts the client marked wrong + their clarification text.
  wrongSections String[]
  clarification String?
  addedPhotoIds String[]
  createdAt    DateTime @default(now())

  @@index([requestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Quotes (Presupuestos) — issue #12
// ─────────────────────────────────────────────────────────────────────────────

enum QuoteStatus {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  CADUCADO
}

enum QuoteLineKind {
  VISITA
  DESPLAZAMIENTO
  MANO_OBRA
  MATERIALES
  PREPARACION
  RETIRADA_LIMPIEZA
  OTRO
}

model Quote {
  id            String      @id @default(cuid())
  request       Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId     String
  version       Int
  status        QuoteStatus @default(BORRADOR)

  workDescription String
  lines         QuoteLine[]

  // All amounts are integer EUR cents (issue #12: no floating point).
  subtotalCents Int
  taxRateBps    Int         @default(2100) // 21% IVA in basis points
  taxCents      Int
  totalCents    Int
  // Benchmark D4: distinguish a firm total from a labelled estimate.
  isEstimate    Boolean     @default(false)
  maxTotalCents Int?

  // Visit / diagnosis fee handling (D4)
  visitFeeCents Int?
  visitFeeDiscounted Boolean @default(false)

  exclusionsNote String?
  assumptions   String[]     // "supuestos que podrían modificar el precio"
  extrasApprovalNote String?  // procedimiento de aprobación de extras
  preparatoryNote String?

  professionalRef String?     // internal professional or free reference
  verificationScope String?   // "alcance de la verificación del profesional"

  scheduledFor  DateTime?     // fecha/franja
  durationEstimate String?    // duración estimada

  warrantyText  String?       // garantía aplicable
  warrantyResponsible String? // responsable de la garantía

  estimatedTimeframe String?
  validUntil    DateTime?
  observations  String?
  attachmentKey String?       // private blob key

  sentAt        DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  // Evidence recorded when the client accepts/rejects via the signed link (#16).
  decisionEvidence Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([requestId, version])
  @@index([requestId, status])
}

model QuoteLine {
  id          String        @id @default(cuid())
  quote       Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  kind        QuoteLineKind @default(OTRO)
  concept     String
  amountCents Int           // integer cents; may be 0 for an "included, no charge" line
  included    Boolean       @default(true) // false = explicitly NOT included
  position    Int           @default(0)

  @@index([quoteId, position])
}

// ─────────────────────────────────────────────────────────────────────────────
// Communications (issue #13)
// ─────────────────────────────────────────────────────────────────────────────

enum CommChannel {
  EMAIL
  WHATSAPP
}

enum CommKind {
  CONFIRMATION
  INFO_REQUEST
  QUOTE_AVAILABLE
  GENERIC
}

enum CommStatus {
  PENDING
  SENT
  FAILED
  LINK_PREPARED // WhatsApp: link generated, not auto-sent
}

model Communication {
  id           String     @id @default(cuid())
  request      Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId    String
  channel      CommChannel
  kind         CommKind
  status       CommStatus @default(PENDING)
  subject      String?
  // Rendered body is kept for the audit trail; secrets/tokens are never stored here.
  bodyPreview  String?
  providerId   String?
  error        String?
  attempts     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([requestId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Consent (issues #10, #14, #18)
// ─────────────────────────────────────────────────────────────────────────────

enum ConsentType {
  REQUEST_HANDLING
  OPERATIONAL_COMMS
  MARKETING
  INSURANCE_DOC_ANALYSIS
  ANALYTICS
}

model Consent {
  id          String      @id @default(cuid())
  request     Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  type        ConsentType
  granted     Boolean
  textVersion String // which version of the legal text was shown
  createdAt   DateTime    @default(now())

  @@unique([requestId, type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Status history — immutable (issue #9)
// ─────────────────────────────────────────────────────────────────────────────

enum ActorType {
  CLIENT
  ADMIN
  SYSTEM
}

model StatusEvent {
  id         String        @id @default(cuid())
  request    Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  from       RequestStatus?
  to         RequestStatus
  actorType  ActorType
  actorId    String? // admin user id, or null for client/system
  reason     String?
  createdAt  DateTime      @default(now())

  @@index([requestId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Insurance branch (issues #14, #15)
// ─────────────────────────────────────────────────────────────────────────────

enum InsuranceExtractionStatus {
  PENDING
  PARTIAL
  DONE
  UNREADABLE
}

enum CoverageVerdict {
  COBERTURA_PROBABLE
  EXCLUSION_PROBABLE
  DUDOSA
  INFORMACION_INSUFICIENTE
}

enum DraftReviewStatus {
  BORRADOR_PENDIENTE_REVISION
  REVISADO_PRAETORIA
}

model InsuranceCase {
  id                 String   @id @default(cuid())
  request            Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId          String   @unique
  consentGiven       Boolean  @default(false)
  documents          InsuranceDocument[]
  extractionStatus   InsuranceExtractionStatus @default(PENDING)
  // Tentative identification (issue #14).
  insurerName        String?
  policyNumber       String?
  validFrom          DateTime?
  validTo            DateTime?
  extraction         Json? // structured extraction with page references
  missingDocsNote    String?

  coverage           CoverageAnalysis?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InsuranceDocument {
  id            String   @id @default(cuid())
  case          InsuranceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String
  storageKey    String // encrypted private blob
  contentType   String
  byteSize      Int
  kind          String? // "condiciones particulares" | "condiciones generales" | "otro"
  ocrUsed       Boolean  @default(false)
  pageCount     Int?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([caseId])
}

model CoverageAnalysis {
  id             String   @id @default(cuid())
  case           InsuranceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId         String   @unique
  verdict        CoverageVerdict
  // Structured result with exact page/text references (issue #15).
  result         Json
  confidence     Int?
  draftText      String? // "parte" / reclamación draft
  draftStatus    DraftReviewStatus @default(BORRADOR_PENDIENTE_REVISION)
  reviewedByAdminId String?
  reviewedAt     DateTime?
  revisions      CoverageDraftRevision[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CoverageDraftRevision {
  id         String   @id @default(cuid())
  coverage   CoverageAnalysis @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  coverageId String
  adminId    String?
  note       String?
  draftText  String
  createdAt  DateTime @default(now())

  @@index([coverageId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin users (issue #11)
// ─────────────────────────────────────────────────────────────────────────────

enum AdminRole {
  OPERATOR
  ADMIN
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole  @default(OPERATOR)
  disabledAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  actions      AdminActionLog[]
}

// Who did what (issue #11: "Registro de quién realiza cada acción").
model AdminActionLog {
  id             String   @id @default(cuid())
  admin          AdminUser @relation(fields: [adminId], references: [id])
  adminId        String
  requestId      String?
  professionalId String?  // set for professional-network actions (issue #22)
  action         String
  detail         Json?
  createdAt      DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([adminId, createdAt])
  @@index([professionalId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Signed client links (issue #16)
// ─────────────────────────────────────────────────────────────────────────────

model ClientLink {
  id          String   @id @default(cuid())
  requestId   String
  // Hash of the token — the raw token is never stored.
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([requestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Professional network (issue #22) — manual verification + assignment guardrails.
// Documents are private blobs; personal data is kept to what is needed; history
// is never destroyed (suspension only).
// ─────────────────────────────────────────────────────────────────────────────

enum ProfessionalStatus {
  CANDIDATO
  DOCUMENTACION_PENDIENTE
  VERIFICANDO
  APROBADO
  SUSPENDIDO
  RECHAZADO
}

// First-contact intake from the public recruitment landing (issue #20). Kept
// separate from the verified Professional network: approving one creates a
// Professional in CANDIDATO.
enum ProfessionalApplicationStatus {
  NUEVA
  CONTACTADA
  EN_VALIDACION
  APROBADA
  RECHAZADA
}

model ProfessionalApplication {
  id              String                        @id @default(cuid())
  name            String
  isCompany       Boolean                       @default(false)
  trades          String[]
  municipalities  String[]
  phone           String
  email           String
  availabilityNote String?
  experienceNote  String?
  observations    String?
  consentAt       DateTime

  status          ProfessionalApplicationStatus @default(NUEVA)
  internalNotes   String?
  reviewReason    String? // reason recorded on rejection
  spamFlagged     Boolean                       @default(false)
  // email|phone|sorted-trades — used for idempotency / dedup (issue #20).
  fingerprint     String

  // Set when an admin converts an APROBADA application into a network member.
  professionalId  String?

  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([status])
  @@index([fingerprint])
}

// What was actually checked in a verification. CONTACT (phone/email) alone never
// counts as "verificado" for the client-facing scope (issue #22 rule).
enum VerificationKind {
  IDENTITY
  FISCAL
  RC_INSURANCE
  CREDENTIAL
  REFERENCES
  BANK_ACCOUNT
  CONTACT
}

model Professional {
  id             String   @id @default(cuid())
  reference      String   @unique // internal non-sequential ref (e.g. PRO-7Q2M)
  status         ProfessionalStatus @default(CANDIDATO)

  legalName      String
  displayName    String   // shown to the client
  taxId          String?  // NIF/CIF
  phone          String?
  email          String?

  trades         String[] // admitted trade keys
  municipalities String[] // covered municipalities
  availabilityNote String?
  experienceNote String?
  referencesNote String?

  // RC (responsabilidad civil) insurance
  rcInsurer      String?
  rcPolicyNumber String?
  rcExpiresAt    DateTime?

  // Bank — only the last 4 of the IBAN in the DB; the full number, if ever
  // needed, lives in a document blob, not here.
  bankIbanLast4  String?

  // Client-facing photo — served via a signed URL and ONLY when photoConsent.
  photoStorageKey String?
  photoConsent   Boolean  @default(false)

  internalRating Int?     // 1..5, internal only, never shown to the client
  approvedAt     DateTime?
  suspendedAt    DateTime?

  credentials    ProfessionalCredential[]
  verifications  ProfessionalVerification[]
  documents      ProfessionalDocument[]
  assignments    Assignment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model ProfessionalCredential {
  id             String   @id @default(cuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String
  trade          String   // the regulated trade this credential authorizes
  label          String
  reference      String?  // credential number
  issuedAt       DateTime?
  expiresAt      DateTime? // null = no stated expiry
  createdAt      DateTime @default(now())

  @@index([professionalId])
  @@index([expiresAt])
}

model ProfessionalVerification {
  id               String   @id @default(cuid())
  professional     Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId   String
  kind             VerificationKind
  checkedByAdminId String
  checkedAt        DateTime @default(now())
  passed           Boolean
  note             String?
  expiresAt        DateTime? // when this check must be redone

  @@index([professionalId, checkedAt])
  @@index([expiresAt])
}

model ProfessionalDocument {
  id             String   @id @default(cuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String
  kind           String   // "identidad" | "fiscal" | "rc" | "carne" | "referencias" | "bancario" | "otro"
  storageKey     String   // encrypted private blob
  contentType    String
  byteSize       Int
  expiresAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([professionalId])
  @@index([expiresAt])
}

model Assignment {
  id                String   @id @default(cuid())
  request           Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId         String
  professional      Professional @relation(fields: [professionalId], references: [id])
  professionalId    String
  assignedByAdminId String
  assignedAt        DateTime @default(now())
  active            Boolean  @default(true)
  // Set when this professional is replaced — the row stays for traceability.
  endedAt           DateTime?
  endedReason       String?

  @@index([requestId, active])
  @@index([professionalId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service closure, incidences & post-service review (issue #23)
// ─────────────────────────────────────────────────────────────────────────────

enum WarrantyKind {
  LEGAL
  COMERCIAL
  CORTESIA
}

enum IncidenceStatus {
  ABIERTA
  EN_CLASIFICACION
  EN_CURSO
  RESUELTA
  DESESTIMADA
}

enum ReviewStatus {
  PENDIENTE
  RETENIDA_PII
  AUTORIZADA
  RECHAZADA
  RETIRADA
}

model ServiceCompletion {
  id                       String    @id @default(cuid())
  request                  Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId                String    @unique
  completedAt              DateTime
  workDone                 String
  materialsNote            String?
  finalPhotosNote          String?
  executedByProfessionalId String?
  // Economic traceability (issue #23): which quote version, which approved extras.
  acceptedQuoteVersion     Int?
  approvedExtrasNote       String?
  // Warranty — one of three kinds, never a uniform term (issue #23 rule).
  warrantyKind             WarrantyKind?
  warrantyText             String?
  warrantyExclusions       String?
  warrantyResponsible      String?
  clientConfirmedAt        DateTime?
  recordedByAdminId        String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Incidence {
  id                 String          @id @default(cuid())
  reference          String          @unique // INC-XXXX
  request            Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId          String
  status             IncidenceStatus @default(ABIERTA)
  openedBy           ActorType
  kind               String? // classification set by an admin
  description        String
  assignedToAdminId  String?
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  resolutionNote     String?
  closedReason       String?
  // A resolution / dismissal is never recorded without evidence (issue #23 rule).
  evidenceNote       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  events             IncidenceEvent[]

  @@index([status])
  @@index([requestId])
  @@index([firstResponseDueAt])
}

model IncidenceEvent {
  id          String          @id @default(cuid())
  incidence   Incidence       @relation(fields: [incidenceId], references: [id], onDelete: Cascade)
  incidenceId String
  actorType   ActorType
  actorId     String?
  fromStatus  IncidenceStatus?
  toStatus    IncidenceStatus?
  note        String?
  createdAt   DateTime        @default(now())

  @@index([incidenceId, createdAt])
}

model Review {
  id                  String       @id @default(cuid())
  request             Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId           String       @unique
  rating              Int // 1..5 overall
  // Optional dimensions (issue #26) — 1..5 each, null = not rated.
  punctuality         Int?
  clarity             Int?
  cleanliness         Int?
  result              Int?
  comment             String? // the published text (redacted if PII was found)
  originalComment     String? // internal only — pre-redaction text, for audit
  // A name is only shown if the client explicitly consented.
  authorDisplayName   String?
  publishConsent      Boolean      @default(false)
  // Who did the work — kept internally on the review (issue #26).
  professionalId      String?

  // Publication is an explicit admin decision; never automatic.
  status              ReviewStatus @default(PENDIENTE)
  authorizedByAdminId String?
  authorizedAt        DateTime?
  publishedAt         DateTime?

  // Moderation (issue #26).
  piiFlagged          Boolean      @default(false)
  piiKinds            String[]
  spamFlagged         Boolean      @default(false)
  duplicateFlagged    Boolean      @default(false)
  moderationReason    String?
  moderatedByAdminId  String?
  moderatedAt         DateTime?

  // Praetoria's public response.
  praetoriaResponse   String?
  respondedByAdminId  String?
  respondedAt         DateTime?

  // Right to withdraw.
  withdrawnAt         DateTime?
  withdrawalReason    String?

  // A negative review can open an incidence (issue #26) — link kept, no PII.
  incidenceId         String?

  createdAt           DateTime     @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Editorial CMS (issue #24) — block-based content, published from the admin panel
// without a code deploy.
// ─────────────────────────────────────────────────────────────────────────────

enum ArticleStatus {
  BORRADOR
  REVISION
  PROGRAMADO
  PUBLICADO
  ARCHIVADO
}

enum ArticleKind {
  GUIA
  ARTICULO
  FAQ
  SEGURIDAD
  SEGUROS
  CASO
  PROBLEMA
  OTRO
}

model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  body            Json          // validated Block[] (src/domain/content/blocks.ts)
  kind            ArticleKind   @default(ARTICULO)
  status          ArticleStatus @default(BORRADOR)

  author          String?
  expertReviewer  String?
  // A hard gate: nothing is PUBLICADO / PROGRAMADO without this (issue #24).
  reviewedByHuman Boolean       @default(false)

  coverImageSrc   String?
  coverImageAlt   String?
  coverCaption    String?
  coverCredit     String?

  // SEO
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  socialImage     String?
  targetKeywords  String[]

  // Internal only — never rendered publicly.
  sources         String?
  internalNotes   String?

  publishAt       DateTime? // scheduled publish time
  publishedAt     DateTime?
  nextReviewAt    DateTime?

  revisions       ArticleRevision[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([publishAt])
  @@index([kind])
}

model ArticleRevision {
  id              String   @id @default(cuid())
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId       String
  editedByAdminId String?
  // full snapshot of the editable fields at that moment (for restore)
  snapshot        Json
  note            String?
  createdAt       DateTime @default(now())

  @@index([articleId, createdAt])
}

model SlugRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  toSlug    String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Local SEO (issue #25) — a `/zonas/[municipio]` page exists ONLY when an admin
// creates it, and is indexed ONLY when it carries real, differentiating content
// (D10 — see src/domain/local-seo/local-page.ts). No LocalPage → the route 404s.
// ─────────────────────────────────────────────────────────────────────────────

enum LocalPageStatus {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

model LocalPage {
  id           String          @id @default(cuid())
  slug         String          @unique // municipio slug, e.g. "burjassot"
  municipality String // display name; must match a covered municipality to be indexable
  serviceKey   String? // optional trade focus (key from src/config/trades.ts)

  intro        String? // page intro paragraph

  // Real differentiating content (D10) — the indexability guard reads these.
  coverageNote     String   @default("")
  typicalServices  String[]
  responseTimeNote String?
  localFaq         Json     @default("[]") // { q: string; a: string }[]
  completedJobsNote String?
  casePhotoNote    String?

  status      LocalPageStatus @default(BORRADOR)
  noindex     Boolean         @default(false)

  metaTitle       String?
  metaDescription String?

  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Local SEO control centre (issue #27). No Search Console / analytics API in
// this MVP — metrics arrive by CSV import. A row's `query` is validated PII-free
// before it is ever stored.
// ─────────────────────────────────────────────────────────────────────────────

model SeoMetricImport {
  id               String          @id @default(cuid())
  source           String // e.g. "gsc-csv", "manual"
  periodStart      DateTime
  periodEnd        DateTime
  note             String?
  rowCount         Int             @default(0)
  skippedCount     Int             @default(0)
  createdByAdminId String
  createdAt        DateTime        @default(now())
  rows             SeoMetricRow[]
}

model SeoMetricRow {
  id           String          @id @default(cuid())
  import       SeoMetricImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  importId     String
  query        String
  page         String?
  clicks       Int             @default(0)
  impressions  Int             @default(0)
  ctr          Float           @default(0) // 0..1
  position     Float           @default(0)
  device       String? // mobile | tablet | desktop
  municipality String?

  @@index([importId])
  @@index([page])
}
